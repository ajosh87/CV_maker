# Copy to .env (git-ignored) only if you want defaults outside the app's Settings page.
# Everything here can also be set in the app under Settings, which takes priority.

# LLM provider: openai | azure | bedrock | ollama | groq | openrouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=your-key-here

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# AWS Bedrock (credentials come from the standard AWS chain)
# AWS_DEFAULT_REGION=us-east-1

# Ollama (fully local; nothing leaves your machine)
# OLLAMA_HOST=http://localhost:11434

# Where your personal data is stored. Default: your per-user app-data folder
#   Windows: %LOCALAPPDATA%\CVTailor   macOS: ~/Library/Application Support/CVTailor   Linux: ~/.local/share/cv-tailor
# Keep it outside this project folder.
# DATA_DIR=

# Session signing key. Leave unset: a random per-install key is generated in the data folder.
# SECRET_KEY=
